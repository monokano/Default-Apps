{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    "%@ is also checked for %@." : {
      "comment" : "Notice: the same extension is checked for another app in the sidebar (1st %@ = extensions, 2nd %@ = app names)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@でもチェックされています。"
          }
        }
      }
    },
    "%lld file types, %lld checked" : {
      "comment" : "Status bar: number of file types and how many are checked",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld種類のファイル（%2$lld種類をチェック）"
          }
        }
      }
    },
    "Add" : {
      "comment" : "Open panel button: adds the chosen apps to the sidebar",
